pkg_name=compiler-rt
version=21.1.7
revision=2
build_style=cmake
short_desc="LLVM compiler-rt runtime libraries (builtins)"
home_page="https://compiler-rt.llvm.org"
license="Apache-2.0 WITH LLVM-exception"
# same tarball as llvm/clang, same download name so the distfiles cache is shared
dist_files="https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-${version}.tar.gz>llvm-${version}.tar.gz"
checksum="f2770e2de83b8dcf045ccf53271e85dc00afa1ee8f770379439b4300e76a5baa"
wrk_src="llvm-project-llvmorg-$version/compiler-rt"
host_make_depends="cmake python clang"

# clang kernel builds link against libclang_rt.builtins instead of libgcc,
# so only the builtins get built; sanitizers and friends can come later
configure_args="
    -DCMAKE_C_COMPILER=clang
    -DCOMPILER_RT_BUILD_BUILTINS=ON
    -DCOMPILER_RT_BUILD_SANITIZERS=OFF
    -DCOMPILER_RT_BUILD_LIBFUZZER=OFF
    -DCOMPILER_RT_BUILD_PROFILE=OFF
    -DCOMPILER_RT_BUILD_XRAY=OFF
    -DCOMPILER_RT_BUILD_ORC=OFF
    -DCOMPILER_RT_BUILD_CRT=OFF
    -DCOMPILER_RT_BUILD_STANDALONE=ON
    -DCOMPILER_RT_INCLUDE_TESTS=OFF
    -Wno-dev"

pre_configure() {
    configure_args="$configure_args -DCOMPILER_RT_DEFAULT_TARGET_TRIPLE=$(clang -dumpmachine)"
    # builtins must live in clang's resource dir or clang falls back to the
    # gcc toolchain's libgcc.a instead of linking libclang_rt.builtins
    configure_args="$configure_args -DCOMPILER_RT_INSTALL_LIBDIR=$(clang -print-resource-dir)/lib/linux"
}
