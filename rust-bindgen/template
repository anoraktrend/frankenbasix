# the Rust bindings generator the kernel's RUST=y build uses, built from the
# crates.io source with its dependency tree vendored into files/vendor (the
# build sandbox has no network); links the system libclang at runtime so the
# kernel's version check sees the same LLVM as clang
pkg_name=rust-bindgen
version=0.72.1
revision=1
build_style=custom
short_desc="Rust FFI bindings generator"
home_page="https://github.com/rust-lang/rust-bindgen"
license="BSD-3-Clause"
# bpm only auto-extracts .tar*/.zip distfiles, so the crates.io .crate (a
# tar.gz) is fetched under a .tar.gz name; the archive itself still unpacks
# to bindgen-cli-<version>/ which is what wrk_src points at
dist_files="https://static.crates.io/crates/bindgen-cli/bindgen-cli-${version}.crate>bindgen-${version}.tar.gz"
checksum="553d230420c015a365fdb538e3045568d8e1192058cfb75c128f42beefb4363e"
wrk_src="bindgen-cli-$version"

depends="llvm"
host_make_depends="rust"

do_build() {
    mkdir -p .cargo
    cp "$FILESDIR/cargo-config" .cargo/config.toml
    cp "$FILESDIR/Cargo.lock" Cargo.lock
    cp -a "$FILESDIR/vendor" vendor

    export CARGO_HOME="$build_dir/.cargo-home"
    cargo build --release --offline --frozen --bin bindgen
}

do_install() {
    binstall target/release/bindgen 0755 /usr/bin bindgen
}
