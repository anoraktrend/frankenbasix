pkg_name=libmicrohttpd
version=1.0.9
revision=1
build_style=gnu-configure
short_desc="C library for embedding an HTTP server"
home_page="https://www.gnu.org/software/libmicrohttpd/"
license="LGPL-2.1-or-later"
dist_files="https://mirrors.edge.kernel.org/gnu/libmicrohttpd/libmicrohttpd-${version}.tar.gz"
checksum="c9bca077ad105013aa5f4406a41687ce2e982fe502aabff7a8b05b913de01c54"
depends="curl gnutls"
make_depends="curl gnutls"

use_flags="curl https"
use_default="+curl +https"

configure_args="
    --disable-doc
    --disable-examples
    $(use_enable curl)
    $(use_enable https)"
