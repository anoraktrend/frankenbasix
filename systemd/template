    networkd resolve timesyncd logind hostnamed localed timedated
    initrd firstboot sysusers tmpfiles hwdb randomseed backlight
    vconsole rfkill repart sysupdate kernel-install
"
use_default="
    +seccomp +pam +libcrypt +libcryptsetup +kmod +lz4 +elfutils +coredump
    +idn +gcrypt +gnutls +microhttpd +qrencode +libfido2 +tpm2 -man -doc
    +smack +ima +ipe +utmp +userdb +networkd +resolve +timesyncd +logind
    +hostnamed +localed +timedated +initrd +firstboot +sysusers +tmpfiles
    +hwdb +randomseed +backlight +vconsole +rfkill +repart +sysupdate
    +kernel-install +bpf-framework +efi +bootloader -apparmor -polkit
"

configure_args="
    -Dlibc=musl
    -Dacl=enabled
    -Dblkid=enabled
    -Dfdisk=enabled
    -Dlibmount=enabled
    -Dopenssl=enabled
    -Dpcre2=enabled
    -Dzlib=enabled
    -Dbzip2=enabled
    -Dxz=enabled
    -Dzstd=enabled
    -Dxkbcommon=enabled
    -Dglib=disabled
    -Ddbus=disabled
    -Dp11kit=disabled
    -Dtranslations=false
    -Dquotacheck=false
    -Dtests=false
    $(use_if seccomp -Dseccomp=enabled -Dseccomp=disabled)
    $(use_if pam -Dpam=enabled -Dpam=disabled)
    $(use_if libcrypt -Dlibcrypt=enabled -Dlibcrypt=disabled)
    $(use_if libcryptsetup -Dlibcryptsetup=enabled -Dlibcryptsetup=disabled)
    $(use_if kmod -Dkmod=enabled -Dkmod=disabled)
    $(use_if lz4 -Dlz4=enabled -Dlz4=disabled)
    $(use_if elfutils -Delfutils=enabled -Delfutils=disabled)
    $(use_bool coredump)
    $(use_bool idn)
    $(use_if gcrypt -Dgcrypt=enabled -Dgcrypt=disabled)
    $(use_if gnutls -Dgnutls=enabled -Dgnutls=disabled)
    $(use_if microhttpd -Dmicrohttpd=enabled -Dmicrohttpd=disabled)
    $(use_if qrencode -Dqrencode=enabled -Dqrencode=disabled)
    $(use_if libfido2 -Dlibfido2=enabled -Dlibfido2=disabled)
    $(use_if tpm2 -Dtpm2=enabled -Dtpm2=disabled)
    $(use_bool tpm2 tpm)
    $(use_if bpf-framework -Dbpf-framework=enabled -Dbpf-framework=disabled)
    $(use_bool efi)
    $(use_if bootloader -Dbootloader=enabled -Dbootloader=disabled)
    $(use_if man -Dman=enabled -Dman=disabled)
    $(use_if doc -Dhtml=enabled -Dhtml=disabled)
    $(use_if apparmor -Dapparmor=enabled -Dapparmor=disabled)
    $(use_if polkit -Dpolkit=enabled -Dpolkit=disabled)
    $(use_bool smack)
    $(use_bool ima)
    $(use_bool ipe)
    $(use_bool utmp)
    $(use_bool userdb)
    $(use_bool networkd)
    $(use_bool resolve)
    $(use_bool timesyncd)
    $(use_bool logind)
    $(use_bool hostnamed)
    $(use_bool localed)
    $(use_bool timedated)
    $(use_bool initrd)
    $(use_bool firstboot)
    $(use_bool sysusers)
    $(use_bool tmpfiles)
    $(use_bool hwdb)
    $(use_bool randomseed)
    $(use_bool backlight)
    $(use_bool vconsole)
    $(use_bool rfkill)
    $(use_if repart -Drepart=enabled -Drepart=disabled)
    $(use_if sysupdate -Dsysupdate=enabled -Dsysupdate=disabled)
    $(use_bool kernel-install)
