depends="acl attr bash bzip2 cryptsetup kmod libbpf libelf libfido2 libgcrypt libxkbcommon gnutls libidn2 linux-pam libmicrohttpd libqrencode libseccomp libucontext lz4 openssl pcre2 python-elftools tpm2-tss util-linux xz zlib zstd"
make_depends="acl attr bzip2 cryptsetup kmod libbpf libelf libfido2 libgcrypt libxkbcommon gnutls libidn2 linux-headers linux-pam libmicrohttpd libqrencode libseccomp libucontext lz4 openssl pcre2 tpm2-tss util-linux xz zlib zstd"
