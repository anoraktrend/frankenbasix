#!/bin/sh
# bpm-use-depends: patch tmpl_load so use_depends/use_make_depends/
# use_host_make_depends fold into the dependency lists
# idempotent; re-fires when bpm itself is reinstalled or updated
set -eu

case ${1:-} in
    bpm|bpm-use-depends) ;;
    *) exit 0 ;;
esac

_f=$2/usr/lib/bpm/common.sh
[ -f "$_f" ] || exit 0

grep -qF 'use_depends_resolve' "$_f" && _r=1 || _r=0

# 1. fold the use_depends family into depends right after the template is
#    sourced (skipped when already patched)
if [ "$_r" = 0 ]; then
    _l=$(grep -nF '    . "$tmpl_dir/template"' "$_f" | head -n1 | cut -d: -f1)
    [ -n "$_l" ] || exit 0
    {
        head -n "$_l" "$_f"
        printf '%s\n' '    if [ -f "$BPM_LIBDIR/use-depends.sh" ]; then . "$BPM_LIBDIR/use-depends.sh"; use_depends_resolve; fi'
        tail -n +"$((_l + 1))" "$_f"
    } > "$_f.new"
    cat "$_f.new" > "$_f"
    rm -f "$_f.new"
fi

# 2. the use_depends family are template vars: let tmpl_clear unset them
#    between loads. matches both the pristine line and the single-var patch
#    shipped by bpm-use-depends rev 1
_l=$(grep -nF " system_accounts system_groups'" "$_f" | head -n1 | cut -d: -f1)
if [ -z "$_l" ]; then
    _l=$(grep -nF " system_accounts system_groups use_depends'" "$_f" | head -n1 | cut -d: -f1)
fi
if [ -n "$_l" ]; then
    _line=$(sed -n "${_l}p" "$_f")
    _prefix=${_line%% system_accounts*}
    {
        head -n "$((_l - 1))" "$_f"
        printf '%s\n' "$_prefix system_accounts system_groups use_depends use_make_depends use_host_make_depends'"
        tail -n +"$((_l + 1))" "$_f"
    } > "$_f.new"
    cat "$_f.new" > "$_f"
    rm -f "$_f.new"
fi
