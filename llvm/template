pkg_name=llvm
version=21.1.7
revision=6
build_style=cmake
short_desc="LLVM toolchain: clang, lld, clang-tools-extra, compiler-rt, libc++, libunwind"
home_page="https://llvm.org"
license="Apache-2.0 WITH LLVM-exception"
dist_files="https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-${version}.tar.gz>llvm-${version}.tar.gz"
checksum="f2770e2de83b8dcf045ccf53271e85dc00afa1ee8f770379439b4300e76a5baa"
wrk_src="llvm-project-llvmorg-$version"
patch_args="-p1"

depends="zlib"
make_depends="zlib"
# no clang in make_depends: core's clang depends on llvm, which would cycle;
# the first bootstrap builds with gcc
host_make_depends="cmake python sccache"
bpm_sccache=1

provides="binutils"
conflicts="binutils"

use_flags="amdgpu"
use_default="+amdgpu"

# the whole toolchain in one package: building the monorepo's projects and
# runtimes together is the only way the install layouts come out right
# (compiler-rt builtins land in clang's resource dir, lld is owned here
# instead of by llvm-binutils)
configure_args="
    -DLLVM_ENABLE_PROJECTS=clang;lld;clang-tools-extra
    -DLLVM_ENABLE_RUNTIMES=compiler-rt;libunwind;libcxx;libcxxabi
    -DLLVM_BUILD_LLVM_DYLIB=ON
    -DLLVM_LINK_LLVM_DYLIB=ON
    -DLLVM_ENABLE_RTTI=ON
    -DLLVM_INCLUDE_BENCHMARKS=OFF
    -DLLVM_INCLUDE_EXAMPLES=OFF
    -DLLVM_INCLUDE_DOCS=OFF
    -DLLVM_INCLUDE_TESTS=OFF
    -DLLVM_ENABLE_TERMINFO=OFF
    -DLLVM_ENABLE_LIBXML2=OFF
    -DLIBCXX_HAS_MUSL_LIBC=ON
    -DCOMPILER_RT_BUILD_SANITIZERS=OFF
    -DCOMPILER_RT_BUILD_LIBFUZZER=OFF
    -DCOMPILER_RT_BUILD_PROFILE=OFF
    -DCOMPILER_RT_BUILD_XRAY=OFF
    -DCOMPILER_RT_BUILD_ORC=OFF
    -DCOMPILER_RT_BUILD_CRT=OFF
    -DCOMPILER_RT_BUILD_CTX_PROFILE=OFF
    -Wno-dev"

do_configure() {
    cmake -S llvm -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_SYSCONFDIR=/etc \
        -DCMAKE_INSTALL_LOCALSTATEDIR=/var \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS="$CFLAGS" -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
        -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS" \
        ${configure_args:-}
}
pre_configure() {
    _targets="host;BPF"
    if use amdgpu; then
        _targets="$_targets;AMDGPU"
    fi

    configure_args="$configure_args
        -DLLVM_TARGETS_TO_BUILD=$_targets
        -DLLVM_HOST_TRIPLE=$(${CC:-cc} -dumpmachine)
        -DCOMPILER_RT_INSTALL_LIBDIR=lib/clang/${version%%.*}/lib/linux"
}

post_install() {
    if [ -d "$DESTDIR/usr/lib/x86_64-pc-linux-musl" ]; then
        mv "$DESTDIR"/usr/lib/x86_64-pc-linux-musl/* "$DESTDIR/usr/lib/"
        rmdir "$DESTDIR/usr/lib/x86_64-pc-linux-musl"
    fi
    # llvm replaces binutils (provides/conflicts), so the clang driver's
    # default linker name must exist; ld.lld accepts the GNU ld flags clang
    # passes (also needed for kernel host tool links, e.g. modpost)
    ln -s ld.lld "$DESTDIR/usr/bin/ld"
}
