# rustc + cargo + rust-src built from source; the src tarball carries the
# crates.io registry under vendor/ and llvm-project under src/, so the build
# never touches the network
pkg_name=rust
version=1.93.1
revision=2
build_style=custom
short_desc="Rust programming language toolchain"
home_page="https://www.rust-lang.org"
license="MIT, Apache-2.0"
dist_files="https://static.rust-lang.org/dist/rustc-${version}-src.tar.xz"
checksum="c8f492b93a95d64efb51fbcc5eab1e8edc1468a3f5be923c756b69d66892161a"
wrk_src="rustc-$version-src"

depends="gcc zlib libressl llvm llvm-binutils clang sccache"
host_make_depends="rust-bootstrap cmake samurai python gcc libressl sccache"

# rustc links against its own std, stripping the toolchain is not supported
no_strip=yes

# 0001-dynamic-musl-by-default.patch (applied by bpm) flips
# crt_static_default in the x86_64-unknown-linux-musl target so binaries link
# against the shared musl, files/config.toml enforces the same for every
# stage of this build and points at /usr for the system musl. cargo links
# against libressl (the vendored openssl-sys rejects openssl 4.x), enforced
# by the OPENSSL_* exports in do_build

do_build() {
    # the prebuilt musl toolchain from rust-bootstrap, keep the version in
    # sync with the one above
    _boot=/usr/lib/rust$version
    [ -x "$_boot/bin/rustc" ] || \
        die "no rust$version bootstrap toolchain, run: bpm install rust-bootstrap"

    # link cargo against libressl: openssl-sys supports LibreSSL 3.5-4.2.x
    # but rejects openssl 4.x. OPENSSL_LIB_DIR holds the libssl.so dev
    # symlinks (/usr/lib/libressl), the headers are under /usr/include/libressl
    export OPENSSL_LIB_DIR=/usr/lib/libressl
    export OPENSSL_INCLUDE_DIR=/usr/include/libressl

    # cache the whole build in sccache: the build dir is wiped by bpm on
    # every run, so without a cache the 30+ min LLVM and crate builds repeat
    # each time. bootstrap only wraps stage0 rustc itself, exporting
    # RUSTC_WRAPPER makes cargo wrap every stage; C/C++ (LLVM) goes through
    # the cc/c++ wrappers. incremental must stay off for sccache (see
    # [rust] incremental = false in files/config.toml)
    export RUSTC_WRAPPER=sccache
    export CC="sccache cc"
    export CXX="sccache c++"
    export SCCACHE_DIR=/var/cache/bpm/build/sccache

    cp "$FILESDIR/config.toml" config.toml

    ./x.py build --stage 2 --jobs "${make_jobs#-j}"
}

do_install() {
    # prefix/sysconfdir come from the [install] section of files/config.toml,
    # x.py install doesn't accept them as arguments
    DESTDIR="$DESTDIR" ./x.py install --stage 2
}
