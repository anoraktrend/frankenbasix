pkg_name=llvm-binutils
version=21.1.7
revision=1
build_style=cmake
short_desc="LLVM-based binutils (lld, llvm-ar, llvm-nm, etc.)"
home_page="https://llvm.org"
license="Apache-2.0 WITH LLVM-exception"
dist_files="https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-${version}.tar.gz>llvm-${version}.tar.gz"
checksum="f2770e2de83b8dcf045ccf53271e85dc00afa1ee8f770379439b4300e76a5baa"
wrk_src="llvm-project-llvmorg-$version/lld"
patch_args="-p2"
depends="llvm"
make_depends="llvm"
host_make_depends="cmake python"
provides="binutils"
conflicts="binutils"

configure_args="
    -DLLVM_ENABLE_RTTI=ON
    -DLLVM_INCLUDE_TESTS=OFF
    -DLLD_INCLUDE_TESTS=OFF
    -DLLD_INCLUDE_DOCS=OFF
    -Wno-dev"

post_install() {
    bln ld.lld /usr/bin/ld
    bln llvm-ar /usr/bin/ar
    bln llvm-nm /usr/bin/nm
    bln llvm-ranlib /usr/bin/ranlib
    bln llvm-strip /usr/bin/strip
    bln llvm-objcopy /usr/bin/objcopy
    bln llvm-objdump /usr/bin/objdump
    bln llvm-readelf /usr/bin/readelf
    bln llvm-strings /usr/bin/strings
    bln llvm-size /usr/bin/size
    bln llvm-dwarfdump /usr/bin/dwarfdump
}
